function styleUpdate(arg0)
{
    selectedNum = arg0;
    
    switch (selectedNum)
    {
        case 0:
            global.playerHpMax = 4;
            global.playerHp = global.playerHpMax;
            global.ammo = 8;
            global.stammo = global.ammo;
            global.pGunType = 0;
            bStatUpdate(global.pGunType, global.pGunLevel);
            break;
        
        case 1:
            global.playerHpMax = 4;
            global.playerHp = global.playerHpMax;
            global.ammo = 8;
            global.stammo = global.ammo;
            global.pGunType = 0;
            bStatUpdate(global.pGunType, global.pGunLevel);
            break;
        
        case 2:
            global.playerHpMax = 6;
            global.playerHp = global.playerHpMax;
            global.ammo = 8;
            global.stammo = global.ammo;
            global.pGunType = 0;
            bStatUpdate(global.pGunType, global.pGunLevel);
            break;
        
        case 3:
            global.playerHpMax = 4;
            global.playerHp = global.playerHpMax;
            global.ammo = 8;
            global.stammo = global.ammo;
            global.pGunType = 0;
            bStatUpdate(global.pGunType, global.pGunLevel);
            break;
        
        case 4:
            global.playerHpMax = 4;
            global.playerHp = global.playerHpMax;
            global.ammo = 8;
            global.stammo = global.ammo;
            global.pGunType = 0;
            bStatUpdate(global.pGunType, global.pGunLevel);
            break;
    }
}
