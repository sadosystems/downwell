function releasenoteText()
{
    if (!global.languageJp)
        return "-cleaner pause menu\\\r\n\t-important things\r\n\t(like hazards)\r\n\twill make lesser\r\n\tthings fade out\\\r\n\t-redone 1st & 2nd\r\n\tarea's level set\r\n\tand enemy pattern\\\r\n\t-3rd and 4th area\r\n\tunchanged\r\n\t(will get to it)\\\r\n\t-level 2 upgrades\r\n\t(experimental)\\\r\n\t-doing combos\r\n\twill now give \r\n\treward\\\r\n\t-merchant has\r\n\tcute animations";
    else
        return "-ポーズメニューをきれいに\\\r\n\t-じゅうようなものがみえやすいように\\\r\n\t-エリア1と2のレベルデザインと\r\n\tてきしゅつげんパターンをへんこう\\\r\n\t-それいこうはまだへんかなし\r\n\t(へんこうします)\\\r\n\t-いくつかのアップグレードに\r\n\tレベル2を\r\n\t(じっけんてき)\\\r\n\t-コンボにたいしてほうしゅうを\\\r\n\t-テンシュにかわいいうごきを";
}
