function scrIncrementPug(arg0)
{
    pugnum = arg0;
    tt = 0;
    
    switch (pugnum)
    {
        case 0:
            global.pugExplodingKnees += 1;
            break;
        
        case 1:
            global.pugEngineer += 1;
            break;
        
        case 2:
            global.pugGravsuit += 1;
            break;
        
        case 3:
            global.pugRip += 1;
            break;
        
        case 4:
            global.pugGemPowered += 1;
            break;
        
        case 5:
            global.pugChainReaction += 1;
            break;
        
        case 6:
            global.pugYouth += 1;
            break;
        
        case 7:
            global.pugCandle += 1;
            break;
        
        case 8:
            global.pugLeak += 1;
            break;
        
        case 9:
            global.pugDrone += 1;
            break;
        
        case 10:
            global.pugAttractor += 1;
            break;
        
        case 11:
            global.pugKnifefork += 1;
            break;
        
        case 12:
            global.pugLasersight += 1;
            break;
        
        case 13:
            break;
        
        case 14:
            global.pugMember += 1;
            break;
        
        case 15:
            global.pugDecoy += 1;
            break;
        
        case 16:
            global.pugGemPop += 1;
            break;
        
        case 17:
            global.pugTime += 1;
            break;
        
        case 18:
            global.pugRocket += 1;
            break;
        
        case 19:
            break;
        
        case 20:
            global.pugLessResist += 1;
            break;
        
        case 21:
            break;
        
        case 22:
            global.pugJet += 1;
            break;
    }
}
