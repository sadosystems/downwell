function scrControlInit()
{
    global.dLeft = 0;
    global.padCancel = 0;
    global.dTouchLeft = 0;
    global.dTouchLeftPressed = 0;
    global.dTouchRight = 0;
    global.dTouchRightPressed = 0;
    global.dTouchUp = 0;
    global.dTouchUpRel = 0;
    global.dTouchUpHeld = 0;
    global.pauseInput = 0;
    global.anyInput = 0;
    analogPressed = 0;
}
