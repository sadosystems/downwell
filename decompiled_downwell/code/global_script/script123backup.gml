function script123backup()
{
    for (i = 0; i <= global.playerProgress; i += 1)
    {
        switch (i)
        {
            case 0:
                break;
            
            case 1:
                global.shaderArUnlocked += 1;
                break;
            
            case 2:
                global.shaderArUnlocked += 1;
                break;
            
            case 3:
                global.styleUnlock += 1;
                break;
            
            case 4:
                global.shaderArUnlocked += 1;
                break;
            
            case 5:
                global.shaderArUnlocked += 1;
                break;
            
            case 6:
                global.shaderArUnlocked += 1;
                break;
            
            case 7:
                global.styleUnlock += 1;
                break;
            
            case 8:
                global.shaderArUnlocked += 1;
                break;
            
            case 9:
                global.shaderArUnlocked += 1;
                break;
            
            case 10:
                global.shaderArUnlocked += 1;
                break;
            
            case 11:
                global.styleUnlock += 1;
                break;
            
            case 12:
                global.shaderArUnlocked += 1;
                break;
            
            case 13:
                global.styleUnlock += 1;
                break;
            
            case 14:
                global.shaderArUnlocked += 1;
                break;
            
            case 15:
                global.shaderArUnlocked += 1;
                break;
            
            case 16:
                global.shaderArUnlocked += 1;
                break;
            
            case 17:
                global.shaderArUnlocked += 1;
                break;
            
            case 18:
                global.shaderArUnlocked += 1;
                break;
            
            case 19:
                global.shaderArUnlocked += 1;
                break;
            
            case 20:
                global.shaderArUnlocked += 1;
                global.shaderArUnlocked = global.shaderArMax;
                break;
        }
    }
}
