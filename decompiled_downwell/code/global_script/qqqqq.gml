function qqqqq()
{
    switch (global.playStyle)
    {
        case 0:
            spriteIdle = 31;
            spriteRun = 27;
            spriteAir = 37;
            spriteSpin = 1;
            spriteShoot = 3;
            spriteYay = 10;
            break;
        
        case 1:
            spriteIdle = 33;
            spriteRun = 25;
            spriteAir = 37;
            spriteSpin = 1;
            spriteShoot = 3;
            spriteYay = 10;
            break;
        
        case 2:
            spriteIdle = 34;
            spriteRun = 1;
            spriteAir = 37;
            spriteSpin = 1;
            spriteShoot = 3;
            spriteYay = 10;
            imgsprun = 0.25;
            imgspstand = 0.2;
            break;
        
        case 3:
            spriteIdle = 35;
            spriteRun = 28;
            spriteAir = 28;
            spriteSpin = 1;
            spriteShoot = 3;
            spriteYay = 10;
            break;
        
        case 4:
            spriteIdle = 32;
            spriteRun = 29;
            spriteAir = 37;
            spriteSpin = 1;
            spriteShoot = 3;
            spriteYay = 10;
            break;
    }
}
